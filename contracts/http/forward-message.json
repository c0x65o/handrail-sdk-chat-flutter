{
  "schemaVersion": 1,
  "method": "POST",
  "path": "/messages/forward",
  "operation": "forward_message.v1",
  "inputFields": [
    { "name": "operation", "type": "literal" },
    { "name": "sourceMessageId", "type": "MessageId" },
    { "name": "destinationConversationId", "type": "ConversationId" },
    { "name": "clientCorrelationId", "type": "nonBlankString" },
    { "name": "idempotencyKey", "type": "nonBlankString" }
  ],
  "resultFields": [
    { "name": "operation", "type": "literal" },
    { "name": "reconciliationStatus", "type": "reconciliationStatus" },
    { "name": "clientCorrelationId", "type": "nonBlankString", "source": "input" },
    { "name": "destinationConversationId", "type": "ConversationId", "source": "input" },
    { "name": "message", "type": "Message", "source": "server" },
    { "name": "canonicalRevision", "type": "positiveSafeInteger", "source": "server" }
  ],
  "reconciliationStatuses": [
    { "name": "applied" },
    { "name": "replayed" }
  ],
  "canonicalRevisionRule": "createdMessageRevisionOne",
  "resultConsistency": {
    "requiresOriginalInput": true,
    "echoClientCorrelationId": true,
    "echoDestinationConversationId": true,
    "messageConversationMatchesDestination": true,
    "snapshotSourceMessageMatchesInput": true,
    "destinationMessageIdentityComesFromServer": true,
    "destinationAuthorComesFromAuthenticatedActor": true
  },
  "snapshot": {
    "contentField": "forwarded",
    "fields": ["sourceMessageId", "originalAuthor", "originalCreatedAt"],
    "originalAuthorFields": ["userId", "displayName"],
    "displayContentFields": ["format", "text", "mentions", "forwarded"],
    "snapshotSemantics": "immutable_display_copy",
    "liveSourceResolution": "forbidden",
    "rawHtml": "forbidden",
    "blocks": "forbidden",
    "trustedSessionOrPrivateAuthorizationData": "forbidden"
  },
  "attachmentPolicy": {
    "sourceReferences": "unsupported",
    "destinationReferences": "forbidden",
    "errorCode": "source_attachments_unsupported",
    "silentDrop": false,
    "referenceReuse": false
  },
  "errorCodes": [
    "malformed_input",
    "trusted_identity_field",
    "server_owned_field",
    "malformed_result",
    "correlation_mismatch",
    "destination_conversation_mismatch",
    "source_message_mismatch",
    "noncanonical_destination",
    "malformed_attribution",
    "source_attachments_unsupported",
    "source_message_not_found",
    "source_message_forbidden",
    "destination_conversation_not_found",
    "destination_conversation_forbidden",
    "idempotency_conflict"
  ],
  "trustedIdentityAliases": [
    "tenant",
    "tenantId",
    "organization",
    "organizationId",
    "actor",
    "actorId",
    "actorContext",
    "actorUserId",
    "currentActor",
    "currentActorId",
    "currentUser",
    "currentUserId",
    "user",
    "userId",
    "author",
    "authorId",
    "authorUserId",
    "principal",
    "principalId",
    "subject",
    "subjectId",
    "authenticatedUser",
    "authenticatedUserId",
    "identity",
    "session",
    "sessionId",
    "auth",
    "authentication",
    "authorization",
    "role",
    "roles",
    "capability",
    "capabilities",
    "permission",
    "permissions"
  ],
  "serverOwnedAliases": [
    "message",
    "messageId",
    "destinationMessageId",
    "content",
    "forwarded",
    "attribution",
    "canonicalRevision",
    "reconciliationStatus"
  ]
}
